# 复制此文件为 .env 并填入真实值
# Copy this file to .env and fill in real values

# DeepSeek API（通过 OpenAI SDK 调用）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# 本项目对官方 DeepSeek V4 默认关闭 thinking，避免短摘要预算被推理耗尽；可改 enabled。
# 仅适用于实际 api.deepseek.com 客户端；调用方显式 extra_body.thinking 优先。
DEEPSEEK_THINKING_MODE=disabled

# 本地嵌入模型：首次索引/预热可能下载；install 不下载模型权重。
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
# Encode microbatch size (1..512), independent of index write batch size.
EMBEDDING_BATCH_SIZE=32
# PyTorch intra-op threads, process-wide; applied at model initialization.
# 0 leaves the runtime setting unchanged. Restart before comparing settings.
EMBEDDING_CPU_THREADS=0
# 为索引可复现性建议填经过验证的模型提交 revision；空值不代表已固定版本。
EMBEDDING_MODEL_REVISION=
# 已知维度才填写；不应猜测。
# EMBEDDING_DIMENSION=1024
# 仅用于Docker构建的显式权重预下载；默认关闭。
PRELOAD_EMBEDDING_MODEL=false

# HuggingFace 模型缓存目录（可选；如需避免占用默认缓存目录，可自行打开）
# HF_HOME=./.hf_cache
# Cross-encoder model loading is most reliable with official Hugging Face.
# If your network cannot access it, switch to a working mirror and run a V7 smoke test first.
HF_ENDPOINT=https://huggingface.co

# ChromaDB 持久化目录
# Windows 的完整解析路径必须仅含 ASCII；中文项目目录请改为 E:/email-agent-runtime/chroma_db
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=emails

# 分块参数
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MIN_CHUNK_SIZE=50

# 检索参数
TOP_K=5
VECTOR_WEIGHT=0.7
BM25_WEIGHT=0.3
RERANK_TOP_N=3
RERANKER_BACKEND=cross_encoder
RERANK_INPUT_CHAR_LIMIT=1200
GENERATION_CONTEXT_CHAR_LIMIT=6000
CROSS_ENCODER_MODEL=BAAI/bge-reranker-v2-m3
CROSS_ENCODER_DEVICE=cpu
CROSS_ENCODER_MAX_LENGTH=512

# 邮件数据路径
EMAIL_DATA_PATH=./data/emails.json

# 163 本地只读邮箱；账号、原件、独立全文索引及调度状态保存在 E 盘。
MAIL_ACCOUNTS_PATH=E:/email-agent-runtime/mail-accounts.sqlite3
IMAP_DATA_ROOT=E:/email-agent-runtime/imap
# 未设置时，调度数据库与 MAIL_ACCOUNTS_PATH 位于同一目录。
MAIL_SCHEDULE_PATH=E:/email-agent-runtime/mail-schedules.sqlite3
MAIL_SCHEDULER_ENABLED=true
# 同步后在本地更新当前 owner 的 AI 索引；问答时相关邮件片段会提交给已配置的模型。
MAIL_AI_INDEX_ENABLED=false
# 此开关仅启用调度服务；每个邮箱仍需在页面保存自动同步设置。

# API 服务
API_HOST=127.0.0.1
API_PORT=8000
# 单用户部署。纯本机可留空；Docker、反向代理或远程访问必须设置随机长token。
# 前端自动转发该token。Bearer token代表唯一owner，不是多租户登录。
API_AUTH_TOKEN=
API_OWNER_ID=local
API_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
SESSION_TTL_SECONDS=3600
MAX_SESSIONS=1000
RETRIEVAL_TIMEZONE_OFFSET_HOURS=8

# 前端连接的 API 地址
API_URL=http://localhost:8000

# Feature flags（默认 = V2：向量 + BM25 + RRF，业务推荐配置）
# 想跑全开 V4 配置体验消融对比，把 RERANKER 和 QUERY_REWRITE 改成 true
# 完整 7 版评测见 docs/evaluation.md
ENABLE_BM25=true
ENABLE_RRF=true
ENABLE_RERANKER=false
ENABLE_QUERY_REWRITE=false

# LLM 超时（秒）
LLM_TIMEOUT=60
EVAL_JUDGE_TIMEOUT_SECONDS=30
EVAL_JUDGE_CONTEXT_CHAR_LIMIT=24000
EVIDENCE_VERIFY_CHAR_LIMIT=60000

# Agent loop
AGENT_PLANNER_MODEL=deepseek-chat
AGENT_MAX_STEPS=6
AGENT_MAX_REPEAT=2
AGENT_TOOL_OUTPUT_LIMIT=4000
AGENT_MAX_TOKENS=4000
AGENT_MAX_TOOL_CALLS=12
AGENT_RUN_TIMEOUT=120
AGENT_CONTEXT_CHAR_LIMIT=60000

# Tool backend: local = current in-process function calling tools; mcp = discover/call MCP server tools
AGENT_TOOL_BACKEND=local

# Standalone MCP server defaults. Port 8001 avoids the FastAPI :8000 server.
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_SERVER_URL=http://127.0.0.1:8001/mcp
MCP_AUTH_TOKEN=
# 必须与调用端API_OWNER_ID相同；留空/不设置时继承API_OWNER_ID。
# 如设置该变量，请明确填写owner，勿保留空字符串。
# MCP_OWNER_ID=local
MCP_TOOL_SCHEMA_CACHE_SECONDS=60
ENABLE_MCP_AUDIT=true
MCP_AUDIT_LOG_PATH=./data/audit/mcp_audit.jsonl
MCP_ALLOWED_TOOLS=
MCP_READ_ONLY_MODE=false

# Human-in-the-loop pending action store
APPROVAL_STORE_PATH=./data/approvals/pending_actions.json
# 旧JSON只读迁移到旁边pending_actions.sqlite3；不要同时运行旧版本写JSON。
APPROVAL_TTL_SECONDS=86400

# Approved mail execution. Default is simulated; gmail creates drafts only.
MAIL_PROVIDER=simulated
# 升级后先显式运行 python -m agents.mail_providers authorize，核验账号并写入授权版本。
# Gmail 审批绑定该账号和 token 文件；重新授权或 token 变化后，旧待审批单须重新生成。
GMAIL_CREDENTIALS_PATH=./credentials/gmail_credentials.json
GMAIL_TOKEN_PATH=./credentials/gmail_token.json
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.compose
GMAIL_USER_ID=me
ENABLE_REAL_EMAIL_SEND=false

# Phase 9: Gmail read-only ingestion. Keep this scope separate from draft-only compose.
GMAIL_READONLY_TOKEN_PATH=./credentials/gmail_readonly_token.json
GMAIL_READONLY_SCOPES=https://www.googleapis.com/auth/gmail.readonly
GMAIL_SYNC_QUERY=newer_than:30d
GMAIL_SYNC_MAX_RESULTS=100
GMAIL_SYNC_OUTPUT_PATH=./data/real_emails/gmail_emails.json
GMAIL_SYNC_STATE_PATH=./data/mail_sync/gmail_sync_state.json

# Agent trace JSONL
ENABLE_AGENT_TRACE=false
AGENT_TRACE_LOG_PATH=./data/traces/agent_traces.jsonl

# 会话和后台任务持久化（含私人对话/检查点）；只运行一个API worker。
SESSION_STORE_PATH=./data/sessions/sessions.sqlite3
SESSION_CONTEXT_TURNS=30
SESSION_CACHE_BYTES=16777216
JOB_STORE_PATH=./data/jobs/jobs.sqlite3
MAX_ACTIVE_REQUESTS=4
MAX_BACKGROUND_JOBS=2
WARMUP_ON_START=false

# 模型上下文与每个逻辑任务预算。0表示该项未启用，不是零成本。
MODEL_CONTEXT_TOKENS=32000
MODEL_OUTPUT_RESERVE_TOKENS=4000
MODEL_RUN_TOKEN_LIMIT=0
MODEL_RUN_COST_LIMIT=0
# 单位：每百万token价格，未知留空；不能当作已经测得的真实账单。
MODEL_INPUT_COST_PER_MILLION=
MODEL_OUTPUT_COST_PER_MILLION=
# 按实际模型名称映射价格；结构见core/model_clients.py，空对象不捏造价格。
MODEL_TOKEN_PRICES={}
MODEL_STREAM_INCLUDE_USAGE=true

# 检索与统计的扫描/内存预算；超限不应伪装为完整命中。
FILTER_METADATA_SCAN_LIMIT=100000
FILTER_METADATA_PAGE_SIZE=500
FILTER_VECTOR_BATCH_SIZE=100
FILTER_LEXICAL_MAX_CHUNKS=10000
FILTER_LEXICAL_CHAR_LIMIT=10000000
BM25_MAX_CHUNKS=100000
BM25_CHAR_LIMIT=10000000
STATS_METADATA_SCAN_LIMIT=100000
RERANKER_COOLDOWN_SECONDS=30
SELF_RAG_GRADE_CHAR_LIMIT=1200
# IANA时区优先，例如Asia/Shanghai；空时回退RETRIEVAL_TIMEZONE_OFFSET_HOURS。
RETRIEVAL_TIMEZONE=

# 审批预算：准备失败不会打开OAuth；已提交但超时的结果需人工核对。
MAIL_APPROVAL_TIMEOUT_SECONDS=30
GMAIL_READ_TIMEOUT=30
GMAIL_SYNC_PAGE_SIZE=100
GMAIL_SYNC_MAX_PAGES_PER_RUN=1000
GMAIL_SYNC_CURSOR_RESET_LIMIT=1

# MIME/导入资源边界。
MIME_PART_LIMIT=1000
MIME_DEPTH_LIMIT=32
MIME_ENCODED_BYTE_LIMIT=16000000
MIME_DECODED_BYTE_LIMIT=8000000
MIME_HEADER_CHAR_LIMIT=64000
MIME_OUTPUT_CHAR_LIMIT=8000000
MIME_PARSE_SECONDS=15
MAX_EMAIL_RECORD_BYTES=16000000
MAX_EMAIL_JSON_DEPTH=64
MAX_INDEX_INPUT_BYTES=2000000000
MAX_INDEX_INPUT_EMAILS=100000
MAX_EMAIL_CHUNKS=10000
MAX_INDEX_INPUT_CHUNKS=250000

# 单进程JSONL轮转；默认每文件5MiB，保留3份轮转副本。
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3
# MCP服务端默认写到MCP_AUDIT_LOG_PATH旁的mcp_server.jsonl。
MCP_SERVER_AUDIT_LOG_PATH=./data/audit/mcp_server.jsonl

# 上下文：确定性检索/选材/引用压缩启用，语义功能默认关闭。
ENABLE_CONTEXT_OPTIMIZATION=true
CONTEXT_HISTORY_LIMIT=12
CONTEXT_MATERIAL_CHAR_LIMIT=4000
CONTEXT_MATERIAL_TOKEN_LIMIT=2000
MODEL_CONTEXT_SAFETY_TOKENS=128
MODEL_REVISION=
MODEL_CONTEXT_PROFILES={}
CONTEXT_PURPOSE_WEIGHTS={}
CONTEXT_TOOL_RESULTS_ENABLED=true
CONTEXT_TOOL_COMPACTION_ENABLED=true
TOOL_RESULT_STORE_PATH=./data/sessions/tool_results.sqlite3
# 以下两项会新增模型调用，选定模型完成质量对照后再启用。
ENABLE_CONTEXT_SUMMARY=false
CONTEXT_SUMMARY_MIN_TURNS=20
CONTEXT_SUMMARY_MAX_OUTPUT_TOKENS=1500
CONTEXT_SUMMARY_MAX_ATTEMPTS=2
ENABLE_CONTEXT_CANDIDATES=false
CONTEXT_CANDIDATE_MAX_OUTPUT_TOKENS=1000
