# 复制此文件为 .env 并填入真实值
# Copy this file to .env and fill in real values

# DeepSeek API（通过 OpenAI SDK 调用）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 本地嵌入模型（首次运行会自动下载，约 570MB）
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu

# HuggingFace 模型缓存目录（可选；如需避免占用默认缓存目录，可自行打开）
# HF_HOME=./.hf_cache
# Cross-encoder model loading is most reliable with official Hugging Face.
# If your network cannot access it, switch to a working mirror and run a V7 smoke test first.
HF_ENDPOINT=https://huggingface.co

# ChromaDB 持久化目录
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=emails

# 分块参数
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MIN_CHUNK_SIZE=50

# 检索参数
TOP_K=5
VECTOR_WEIGHT=0.7
BM25_WEIGHT=0.3
RERANK_TOP_N=3
RERANKER_BACKEND=cross_encoder
RERANK_INPUT_CHAR_LIMIT=1200
GENERATION_CONTEXT_CHAR_LIMIT=6000
CROSS_ENCODER_MODEL=BAAI/bge-reranker-v2-m3
CROSS_ENCODER_DEVICE=cpu
CROSS_ENCODER_MAX_LENGTH=512

# 邮件数据路径
EMAIL_DATA_PATH=./data/emails.json

# API 服务
API_HOST=0.0.0.0
API_PORT=8000

# 前端连接的 API 地址
API_URL=http://localhost:8000

# Feature flags（默认 = V2：向量 + BM25 + RRF，业务推荐配置）
# 想跑全开 V4 配置体验消融对比，把 RERANKER 和 QUERY_REWRITE 改成 true
# 完整 6 版评测见 docs/evaluation.md
ENABLE_BM25=true
ENABLE_RRF=true
ENABLE_RERANKER=false
ENABLE_QUERY_REWRITE=false

# LLM 超时（秒）
LLM_TIMEOUT=60

# Agent loop
AGENT_PLANNER_MODEL=deepseek-chat
AGENT_MAX_STEPS=6
AGENT_MAX_REPEAT=2
AGENT_TOOL_OUTPUT_LIMIT=4000
AGENT_MAX_TOKENS=4000

# Tool backend: local = current in-process function calling tools; mcp = discover/call MCP server tools
AGENT_TOOL_BACKEND=local

# Standalone MCP server defaults. Port 8001 avoids the FastAPI :8000 server.
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_SERVER_URL=http://127.0.0.1:8001/mcp
MCP_AUTH_TOKEN=
MCP_TOOL_SCHEMA_CACHE_SECONDS=60
ENABLE_MCP_AUDIT=true
MCP_AUDIT_LOG_PATH=./data/audit/mcp_audit.jsonl
MCP_ALLOWED_TOOLS=
MCP_READ_ONLY_MODE=false

# Human-in-the-loop pending action store
APPROVAL_STORE_PATH=./data/approvals/pending_actions.json

# Approved mail execution. Default is simulated; gmail creates drafts only.
MAIL_PROVIDER=simulated
GMAIL_CREDENTIALS_PATH=./credentials/gmail_credentials.json
GMAIL_TOKEN_PATH=./credentials/gmail_token.json
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.compose
GMAIL_USER_ID=me
ENABLE_REAL_EMAIL_SEND=false

# Agent trace JSONL
ENABLE_AGENT_TRACE=false
AGENT_TRACE_LOG_PATH=./data/traces/agent_traces.jsonl
